## DEFAULT_PORT is used if not provided
PORT=

DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret for signing HS256 access tokens. Required: at least 32 characters, 8+ distinct,
# and not this placeholder (the app refuses to start with it). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me

# BullMQ key prefix (tests override it per run)
QUEUE_PREFIX=bull
# Start the KYB worker in this process (true|false)
KYB_WORKER_ENABLED=true
# Simulated provider: share of attempts that fail (0..1)
KYB_FAILURE_RATE=0.2
# Score thresholds for MEDIUM and HIGH levels
KYB_SCORE_MEDIUM_MIN=40
KYB_SCORE_HIGH_MIN=70