{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch origin main)",
      "Bash(git switch -c ai/:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin ai/:*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr view:*)",
      "Write(docs/plans/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
